    test("registration - convert - affine - options and custom prefix") {
        config "./nextflow_affine_options.config"

        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.collect().map{ directories ->
                    def transforms = directories.find{ it.simpleName == "freesurfer_transforms" }
                    def reslice = directories.find{ it.simpleName == "freesurfer_reslice" }
                    def freesurfer = directories.find{ it.simpleName == "freesurfer" }
                    [
                        [id: 'test'],
                        file("\${transforms}/fsl_affine.mat"),
                        "fsl",
                        "lta",
                        file("\${reslice}/fa_reslice.nii.gz"),
                        file("\${reslice}/t1_reslice.nii.gz"),
                        file("\${freesurfer}/license.txt")
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.transformation.size() == 1 },
                { assert process.out.transformation[0][0] == [id: 'test'] },
                { assert file(process.out.transformation[0][1]).name == "custom_out_affine.lta" },
                { assert file(process.out.transformation[0][1]).size() > 0 },
                {
                    def command = path(process.out.transformation[0][1]).getParent().resolve('.command.sh').text
                    assert command.contains("--trgconform")
                    assert !command.contains("--downsample")
                },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("registration - convert - warp - downsample and affine option isolation") {
        config "./nextflow_warp_options.config"

        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.collect().map{ directories ->
                    def transforms = directories.find{ it.simpleName == "freesurfer_transforms" }
                    def reslice = directories.find{ it.simpleName == "freesurfer_reslice" }
                    def freesurfer = directories.find{ it.simpleName == "freesurfer" }
                    [
                        [id: 'test'],
                        file("\${transforms}/fs_deform.nii.gz"),
                        "ras",
                        "m3z",
                        file("\${reslice}/t1_reslice.nii.gz"),
                        [],
                        file("\${freesurfer}/license.txt")
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.transformation.size() == 1 },
                { assert process.out.transformation[0][0] == [id: 'test'] },
                { assert file(process.out.transformation[0][1]).name == "test_out_warp.m3z" },
                { assert file(process.out.transformation[0][1]).size() > 0 },
                {
                    def command = path(process.out.transformation[0][1]).getParent().resolve('.command.sh').text
                    assert command.contains("--downsample")
                    assert !command.contains("--trgconform")
                    assert !command.contains("--src ")
                },
                { assert snapshot(file(process.out.transformation[0][1]).name, process.out.versions).match() }
            )
        }
    }

    test("registration - convert - affine - stub custom prefix") {
        tag "stub"
        options "-stub-run"
        config "./nextflow_prefix.config"

        when {
            process {
                """
                input[0] = LOAD_DATA.out.test_data_directory.collect().map{ directories ->
                    def transforms = directories.find{ it.simpleName == "freesurfer_transforms" }
                    def reslice = directories.find{ it.simpleName == "freesurfer_reslice" }
                    def freesurfer = directories.find{ it.simpleName == "freesurfer" }
                    [
                        [id: 'test'],
                        file("\${transforms}/fs_affine.lta"),
                        "lta",
                        "fsl",
                        file("\${reslice}/fa_reslice.nii.gz"),
                        [],
                        file("\${freesurfer}/license.txt")
                    ]
                }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.transformation.size() == 1 },
                { assert process.out.transformation[0][0] == [id: 'test'] },
                { assert file(process.out.transformation[0][1]).name == "custom_out_affine.mat" },
                { assert file(process.out.transformation[0][1]).exists() },
                { assert file(process.out.transformation[0][1]).size() == 0 },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }
}
